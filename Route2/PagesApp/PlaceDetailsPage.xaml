<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Route2.PagesApp.PlaceDetailsPage"
    BackgroundColor="#050514"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*"
            Margin="0,15,0,20">

            <!-- Botão Voltar -->
            <Label
                Grid.Column="0"
                Text="❮"
                TextColor="#FFC800"
                FontSize="30"
                VerticalOptions="Center"
                SemanticProperties.Description="Voltar">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Título -->
            <Label
                Grid.Column="1"
                Text="Destinos Internos"
                TextColor="#FFC800"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center" />
        </Grid>

        <!-- LISTA DE DESTINOS DINÂMICA -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Destinations}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border 
                        BackgroundColor="#454545"
                        StrokeThickness="0"
                        Margin="0,0,0,12"
                        Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <Label 
                                Grid.Row="0" Grid.Column="0"
                                Text="{Binding Name}"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label 
                                Grid.Row="1" Grid.Column="0"
                                Text="{Binding LocationInfo}"
                                TextColor="#CCCCCC"
                                FontSize="14"
                                Margin="0,4,0,0" />

                            <Button 
                                Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                Text="Iniciar Rota"
                                BackgroundColor="#FFC800"
                                TextColor="#000000"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="45"
                                VerticalOptions="Center"
                                Clicked="OnStartRouteClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>