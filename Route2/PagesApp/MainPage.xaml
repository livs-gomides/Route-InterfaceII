<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Route2.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#050B14"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="28,40,28,36"
          RowDefinitions="*,Auto,Auto,*">

        <Image
            Grid.Row="1"
            Source="routesymbol.png"
            WidthRequest="220"
            HeightRequest="190"
            Aspect="AspectFit"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="0"
            HorizontalOptions="Center"
            Margin="0,18,0,0">

            <Label
                Text="Bem-Vindo&#10;à Route"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center"
                LineHeight="1.05" />

            <Label
                Text="Seu Assistente Virtual"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center"
                Margin="0,32,0,0" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
