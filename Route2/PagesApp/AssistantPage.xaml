<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Route2.PagesApp.AssistantPage"
    BackgroundColor="#050514"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- CABEÇALHO (ZIndex alto para nunca ser bloqueado pela área central) -->
        <Grid
            Grid.Row="0"
            ZIndex="10"
            ColumnDefinitions="Auto, *, Auto"
            Padding="20">

            <Image
                Grid.Column="0"
                Source="route_small_logo.png"
                HeightRequest="30"
                Aspect="AspectFit"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                SemanticProperties.Description="Logo Route" />

            <Border
                Grid.Column="2"
                WidthRequest="48"
                HeightRequest="48"
                BackgroundColor="Transparent"
                StrokeThickness="0"
                HorizontalOptions="End"
                VerticalOptions="Center"
                SemanticProperties.Description="Configurações">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
                <Image
                    Source="settings_icon.png"
                    HeightRequest="30"
                    WidthRequest="30"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ÁREA CENTRAL DO ASSISTENTE -->
        <VerticalStackLayout
            Grid.Row="1"
            ZIndex="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="30">

            <!-- Texto de Status Acima -->
            <Label
                x:Name="AssistantTitle"
                Text="Pronto"
                TextColor="White"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <!-- Botão/Imagem Central do Assistente -->
            <ImageButton
                x:Name="AssistantButton"
                Source="assistant_button.png"
                WidthRequest="250"
                HeightRequest="250"
                Aspect="AspectFit"
                BackgroundColor="Transparent"
                SemanticProperties.Description="Botão do assistente de voz"
                Clicked="OnAssistantTapped" />

            <!-- Texto de Ação Abaixo -->
            <Label
                x:Name="AssistantActionText"
                Text="Toque para Falar"
                TextColor="White"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- BARRA DE NAVEGAÇÃO INFERIOR -->
        <Grid
            Grid.Row="2"
            ZIndex="10"
            ColumnDefinitions="*,*"
            HeightRequest="70"
            ColumnSpacing="2"
            BackgroundColor="#050514">

            <!-- Botão Home -->
            <Border Grid.Column="0" BackgroundColor="#454545" StrokeThickness="0">
                <Image
                    Source="home_icon.png"
                    HeightRequest="35"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Início" />
            </Border>

            <!-- Botão Locais Salvos -->
            <Border Grid.Column="1" BackgroundColor="#454545" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSavedPlacesTapped" />
                </Border.GestureRecognizers>
                <Image
                    Source="location_icon.png"
                    HeightRequest="35"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Locais Salvos" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>