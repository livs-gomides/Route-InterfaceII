<?xml version="1.0" encoding="utf-8" ?>
    <ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Route2.PagesApp.ForgetPassword"
    Title="ForgetPassword"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#05090C">

    <Grid BackgroundColor="#05090C">

        <ScrollView
            VerticalScrollBarVisibility="Never">

            <VerticalStackLayout
                Padding="28,35,28,40"
                Spacing="0"
                HorizontalOptions="Fill"
                VerticalOptions="Start">

                <!-- Logotipo -->
                <Image
                    Source="routelogo.png"
                    HeightRequest="175"
                    WidthRequest="175"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Margin="0,95,0,35"/>

                <!-- Título -->
                <Label
                    Text="Esqueci minha senha"
                    TextColor="#F7F7FA"
                    FontSize="34"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Fill"
                    LineBreakMode="WordWrap"/>

                <!-- Subtítulo -->
                <Label
                    Text="Recupere o acesso à sua conta"
                    TextColor="#F0F0F3"
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Fill"
                    Margin="0,8,0,0"/>

                <!-- Campo de e-mail -->
                <Border
                    BackgroundColor="#171E24"
                    Stroke="#222B32"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 30"
                    HeightRequest="90"
                    Padding="22,0"
                    Margin="0,85,0,0">

                    <Grid
                        ColumnDefinitions="56,*"
                        ColumnSpacing="14"
                        VerticalOptions="Center">

                        <Label
                            Text="✉"
                            TextColor="#FFD000"
                            FontSize="40"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            VerticalOptions="Center"/>

                        <Entry
                            x:Name="EmailEntry"
                            Grid.Column="1"
                            Placeholder="E-mail"
                            PlaceholderColor="#B8C0CA"
                            TextColor="White"
                            Keyboard="Email"
                            FontSize="21"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center"/>

                    </Grid>
                </Border>

                <!-- Botão Confirmar -->
                <Button
                    Text="Confirmar"
                    BackgroundColor="#FFD000"
                    TextColor="#050505"
                    FontSize="25"
                    FontAttributes="Bold"
                    CornerRadius="32"
                    HeightRequest="94"
                    HorizontalOptions="Fill"
                    Margin="2,62,2,0"
                    Clicked="OnRecoverButtonClicked"/>

                <!-- Voltar para o login -->
                <Label
                    Text="Voltar para o login"
                    TextColor="#FFD000"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextDecorations="Underline"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center"
                    Margin="0,65,0,25">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnBackToLoginTapped"/>
                    </Label.GestureRecognizers>

                </Label>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>