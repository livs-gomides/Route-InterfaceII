<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Route2.PagesApp.AssistantPage"
    BackgroundColor="#050514"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- CABEÇALHO -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20">
            <Image Grid.Column="0" Source="route_small_logo.png" HeightRequest="30" HorizontalOptions="Start" />
            <ImageButton Grid.Column="2" Source="settings_icon.png" HeightRequest="30" WidthRequest="30" BackgroundColor="Transparent" HorizontalOptions="End" />
        </Grid>

        <!-- ÁREA CENTRAL DO ASSISTENTE -->
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="40">
            <!-- Texto de Status Acima -->
            <Label x:Name="AssistantTitle" Text="Pronto" TextColor="White" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" />

            <!-- Botão/Imagem Central do Assistente -->
            <ImageButton x:Name="AssistantButton" Source="assistant_button_ready.png" WidthRequest="250" HeightRequest="250" BackgroundColor="Transparent" Clicked="OnAssistantTapped" />

            <!-- Texto de Ação Abaixo -->
            <Label x:Name="AssistantActionText" Text="Toque para Falar" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- BARRA DE NAVEGAÇÃO INFERIOR -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" HeightRequest="70" ColumnSpacing="2" BackgroundColor="#050514">
            <!-- Botão Home -->
            <Border Grid.Column="0" BackgroundColor="#454545" StrokeThickness="0">
                <Image Source="home_icon.png" HeightRequest="35" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Botão Locais Salvos -->
            <Border Grid.Column="1" BackgroundColor="#454545" StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSavedPlacesTapped" />
                </Border.GestureRecognizers>
                <Image Source="location_icon.png" HeightRequest="35" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>