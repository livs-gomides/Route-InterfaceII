<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Route2.PagesApp.SignIn"
             Title="Sign-In">
    <Grid Padding="24">
        <Border
            WidthRequest="300"
            HeightRequest="400"
            Padding="24"
            BackgroundColor="#454545"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 18"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout
                Spacing="14"
                HorizontalOptions="Center"
                VerticalOptions="Center">


                <Label
                    Text="Login"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    WidthRequest="230"/>


                <Entry x:Name="EmailEntry" Placeholder="E-mail" Keyboard="Email" />
                <Entry x:Name="PasswordEntry" Placeholder="Senha" IsPassword="True" />

                <Button Text="Entrar" Clicked="OnLoginButtonClicked" />
                  

                <Button
                    Text="Esqueci a senha"
                    BackgroundColor="Black"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold" 
                    HeightRequest="55"
                    WidthRequest="190"
                    Clicked="ForgetPass"/>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>